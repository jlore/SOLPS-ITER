# ORNL site setup for gfortran builds.
#
# The compiler and library details below are selected by ORNL_SYSTEM 

set fullhost=`hostname -f`
set shorthost=`hostname -s`

if (! $?ORNL_SYSTEM) then
  switch ("$shorthost")
    case JLORE2025:
      setenv ORNL_SYSTEM WSL
      breaksw
    case EOS:
    case eos*:
      setenv ORNL_SYSTEM EOS
      breaksw
    case ultrabucky:
      setenv ORNL_SYSTEM ultrabucky
      breaksw
    default:
      setenv ORNL_SYSTEM default
      breaksw
  endsw
endif

echo "Using ORNL system ${ORNL_SYSTEM}."

# Shared defaults
if (! $?DEVICE) setenv DEVICE d3d
if (! $?B2PLOT_DEV) setenv B2PLOT_DEV "ps"
if (! $?FC) setenv FC gfortran
setenv DBX gdb
unsetenv NO_MOTIF

switch ("$ORNL_SYSTEM")
  case WSL:
    # Local WSL Ubuntu build.  No module system is expected: gcc, OpenMPI,
    # BLAS/LAPACK, and netCDF come from Ubuntu packages.  Conda is used only
    # for NCAR Graphics/NCL and the Python tools that are convenient beside
    # SOLPS.
    setenv CC gcc
    setenv FC gfortran
    setenv CXX g++
    setenv MPI_FC /usr/bin/mpif90
    alias ls 'ls --color=auto'
    setenv NO_MANUAL

    if ( $?SOLPS_CONDA_ROOT ) then
      set solps_conda_root = ${SOLPS_CONDA_ROOT}
    else if ( $?CONDA_EXE ) then
      set solps_conda_root = `dirname "$CONDA_EXE"`
      set solps_conda_root = `dirname "$solps_conda_root"`
    else if (-d ${HOME}/miniforge3) then
      set solps_conda_root = ${HOME}/miniforge3
    else if (-d ${HOME}/mambaforge) then
      set solps_conda_root = ${HOME}/mambaforge
    else if (-d ${HOME}/miniconda3) then
      set solps_conda_root = ${HOME}/miniconda3
    else
      set solps_conda_root = ""
    endif

    if ( $?SOLPS_CONDA_ENV ) then
      set solps_conda_env = ${SOLPS_CONDA_ENV}
    else
      set solps_conda_env = solps
    endif

    if ("$solps_conda_root" != "" && ! -d ${solps_conda_root}/envs/${solps_conda_env}) then
      if (-d ${solps_conda_root}/envs/solps-ncarg) then
        set solps_conda_env = solps-ncarg
      endif
    endif

    if ("$solps_conda_root" != "" && -e ${solps_conda_root}/etc/profile.d/conda.csh) then
      source ${solps_conda_root}/etc/profile.d/conda.csh
      if (-d ${solps_conda_root}/envs/${solps_conda_env}) then
        conda activate ${solps_conda_env}
      else
        echo "Warning: no SOLPS conda environment found under ${solps_conda_root}/envs."
      endif
    else
      echo "Warning: SOLPS conda root not found. Set SOLPS_CONDA_ROOT to the Miniforge install path."
    endif

    setenv BLAS_DIR /usr/lib/x86_64-linux-gnu
    setenv NAG_DIR /usr/lib/x86_64-linux-gnu
    if ( $?CONDA_PREFIX ) setenv NCARG_ROOT ${CONDA_PREFIX}

    set nfincl = `/usr/bin/nf-config --includedir`
    set nflib  = `/usr/bin/nf-config --flibs | sed 's/.*-L\([^ ]*\).*/\1/'`
    set ncincl = `/usr/bin/nc-config --includedir`
    set nclib  = `/usr/bin/nc-config --libs | sed 's/.*-L\([^ ]*\).*/\1/'`
    setenv NETCDF_F_INC $nfincl
    setenv NETCDF_C_INC $ncincl
    setenv NETCDF_F_LIB $nflib
    setenv NETCDF_C_LIB $nclib
    setenv NETCDF_F_ROOT `dirname "$nfincl"`
    setenv NETCDF_C_ROOT `dirname "$ncincl"`
    setenv LD_NETCDF "`/usr/bin/nf-config --flibs`"
    if ( $?SOLPSINCLUDE ) then
        setenv SOLPSINCLUDE "-I${nfincl} -I${ncincl} ${SOLPSINCLUDE}"
    else
        setenv SOLPSINCLUDE "-I${nfincl} -I${ncincl}"
    endif

    set mpishow = `${MPI_FC} --showme 2> /dev/null`
    if ("$mpishow" == "") set mpishow = `${MPI_FC} -show`
    set mpilib  = `echo "$mpishow" | sed -n 's/.*-L\([^ ]*\).*/\1/p' | head -n 1`
    set mpiinc  = `echo "$mpishow" | sed -n 's/.*-I\([^ ]*\).*/\1/p' | head -n 1`
    if ("$mpiinc" != "") setenv MPI_ROOT `dirname "$mpiinc"`
    if ("$mpilib" != "") setenv MPI_LIBDIR $mpilib
    if ("$mpiinc" != "") setenv MPI_INCDIR $mpiinc

    setenv solpslibsroot /home/jjl/SOLPS/solps_libs/lib_gfortran
    setenv GLI_HOME  $solpslibsroot
    setenv MSCL_ROOT $solpslibsroot/lib
    setenv GR_SOURCE $solpslibsroot
    setenv SOLPSLIB $solpslibsroot
    if ( $?LD_LIBRARY_PATH ) then
        setenv LD_LIBRARY_PATH "${solpslibsroot}/lib:${solpslibsroot}:${LD_LIBRARY_PATH}"
    else
        setenv LD_LIBRARY_PATH "${solpslibsroot}/lib:${solpslibsroot}"
    endif
    breaksw

  case EOS:
    # Managed Linux server.  Compilers, MPI, netCDF, NCL, and math libraries
    # come from environment modules.  Paths are derived from the loaded tools.
    module load lapack ncl openblas
    module load gcc/15.2.0
    module load openmpi/4.1.7-gcc15.2.0
    module load hdf5/1.14.5-gcc15.2.0
    module load netcdf-c/4.9.2-gcc15.2.0
    module load netcdf-fortran/4.6.1-gcc15.2.0
    module load cmake doxygen
    rehash

    alias ls 'ls --color=auto'
    setenv NO_MANUAL
    setenv MPI_FC mpif90

    setenv BLAS_DIR  `echo "$LIBRARY_PATH" | tr ':' '\n' | awk '{ cmd="test -e " $0 "/libopenblas.so || test -e " $0 "/libopenblas.a"; if (system(cmd)==0) { print $0; exit } }'`
    setenv NAG_DIR   `echo "$LD_LIBRARY_PATH" | tr ':' '\n' | awk '{ cmd="test -e " $0 "/liblapack.so || test -e " $0 "/liblapack.a"; if (system(cmd)==0) { print $0; exit } }'`
    set ncarglib = `echo "$LD_LIBRARY_PATH" | tr ':' '\n' | awk '{ cmd="test -e " $0 "/libncarg.so || test -e " $0 "/libncarg.a"; if (system(cmd)==0) { print $0; exit } }'`
    if ("$ncarglib" != "") setenv NCARG_ROOT `dirname "$ncarglib"`

    set nfincl = `nf-config --includedir`
    set nflib  = `nf-config --flibs | sed 's/.*-L\([^ ]*\).*/\1/'`
    set ncincl = `nc-config --includedir`
    set nclib  = `nc-config --libs | sed 's/.*-L\([^ ]*\).*/\1/'`
    setenv NETCDF_F_INC $nfincl
    setenv NETCDF_C_INC $ncincl
    setenv NETCDF_F_LIB $nflib
    setenv NETCDF_C_LIB $nclib
    setenv NETCDF_F_ROOT `dirname "$nfincl"`
    setenv NETCDF_C_ROOT `dirname "$ncincl"`
    setenv LD_NETCDF "`nf-config --flibs`"
    if ( $?SOLPSINCLUDE ) then
        setenv SOLPSINCLUDE "-I${nfincl} -I${ncincl} ${SOLPSINCLUDE}"
    else
        setenv SOLPSINCLUDE "-I${nfincl} -I${ncincl}"
    endif

    set mpishow = `${MPI_FC} -show`
    set mpilib  = `echo "$mpishow" | sed -n 's/.*-L\([^ ]*\).*/\1/p' | head -n 1`
    set mpiinc  = `echo "$mpishow" | sed -n 's/.*-I\([^ ]*\).*/\1/p' | head -n 1`
    if ("$mpiinc" != "") setenv MPI_ROOT `dirname "$mpiinc"`
    if ("$mpilib" != "") setenv MPI_LIBDIR $mpilib
    if ("$mpiinc" != "") setenv MPI_INCDIR $mpiinc

    setenv solpslibsroot /projects/solps/solps-libs/lib_gfortran
    setenv GLI_HOME  $solpslibsroot
    setenv MSCL_ROOT $solpslibsroot/lib
    setenv GR_SOURCE $solpslibsroot
    setenv SOLPSLIB $solpslibsroot
    if ( $?LD_LIBRARY_PATH ) then
        setenv LD_LIBRARY_PATH "${solpslibsroot}/lib:${solpslibsroot}:${LD_LIBRARY_PATH}"
    else
        setenv LD_LIBRARY_PATH "${solpslibsroot}/lib:${solpslibsroot}"
    endif
    breaksw

  case ultrabucky:
    # Closest to the historical ORNL setup in this tree.
    module load solps-libs/gcc
    rehash

    alias ls 'ls --color=auto'
    setenv MPI_FC mpif90

    breaksw
endsw

# Settings for central ORNL-style installations
if (! $?SOLPSWORK) setenv SOLPSWORK /home/$USER/solps-runs
alias sbr 'cd ${SOLPSWORK}'
if (-e $SOLPSWORK/setup.csh.local) then
  source $SOLPSWORK/setup.csh.local
endif
setenv SOLPS_CENTRAL "yes"

# Common SOLPS workflow aliases
alias 2dtne '2dt.py "nesepm nesepa nesepi"'
alias 2dtte '2dt.py "tesepm tesepa tesepi"'
alias 2dtti '2dt.py "tisepm tisepa tisepi"'
alias 2dtpo '2dt.py "posepm posepa posepi"'
alias resall_D resall_D.py

alias ct "cpu|tail"
alias run_b2coupled "b2run b2mn > run.log &"

alias aaa 'cp b2fstate b2fstati'
alias bbb 'b2run b2mn > run.log &'
alias qqq 'touch b2mn.exe.dir/.quit'
alias sss 'cp b2fstati b2fstati.save'
alias zzz 'cp new_coeffs.txt b2.transport.inputfile'

alias bb4   'b2run -m \"mpirun -np 4\"  b2mn > run.log &'
alias bb8   'b2run -m \"mpirun -np 8\"  b2mn > run.log &'
alias bb16  'b2run -m \"mpirun -np 16\" b2mn > run.log &'
alias bb32  'b2run -m \"mpirun -np 32\" b2mn > run.log &'
alias bb64  'b2run -m \"mpirun -np 64\" b2mn > run.log &'

alias ft 'paste ft3dl.last10 ft3dr.last10 | awk.first+even | xyplot2 ft_l ft_r'
alias fn 'paste fn3dl.last10 fn3dr.last10 | awk.first+even | xyplot2 fn_l fn_r'
alias te 'paste te3dl.last10 te3da.last10 te3dr.last10 | awk.first+even | xyplot3 te_l te_a te_r'
alias ne 'paste ne3dl.last10 ne3da.last10 | awk.first+even | xyplot3 ne_l ne_a ne_r'

alias coreion 'echo "brna 1 zsel sumx writ jxa f.y" | b2plot >& /dev/null'
alias get_pressure 'echo "ny 2 i+ user 100 wlld" | b2plot > & /dev/null && cat b2pl.exe.dir/pressure.ntr'

alias totrad_surf 'echo "phys b2ra b2br m+ abs 0 0 sumz neutrad 0 0 sumz m+ molrad 0 0 sumz m+ ionrad 0 0 sumz m+ pvol surf" | b2plot > & /dev/null'
alias totrad_write 'echo "phys b2ra b2br m+ abs 0 0 sumz neutrad 0 0 sumz m+ molrad 0 0 sumz m+ ionrad 0 0 sumz m+ sumx sumy jxa write f.y" | b2plot > & /dev/null'
alias totrad_outputfile "echo 'phys b2ra b2br m+ abs 0 0 sumz neutrad 0 0 sumz m+ molrad 0 0 sumz m+ ionrad 0 0 sumz m+ pvol "'"../output/totradpvol.out"'" mprt surf' | b2plot"
